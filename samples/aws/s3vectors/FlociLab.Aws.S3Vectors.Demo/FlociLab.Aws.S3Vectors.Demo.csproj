<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Aws.S3Vectors</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). AWSSDK.S3Vectors is the
    same package a production app would reference for S3 Vectors, used exactly as
    production would use it — the only difference is the endpoint, which comes from
    FlociLab.Aws.Endpoints.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3Vectors" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\FlociLab.Aws.Endpoints\FlociLab.Aws.Endpoints.csproj" />
  </ItemGroup>

</Project>
