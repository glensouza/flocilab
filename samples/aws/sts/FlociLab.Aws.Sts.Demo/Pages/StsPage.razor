@page "/aws/sts"
@inject StsDemo Demo
@inject StsClientFactory Factory
@implements IDisposable

<PageTitle>AWS STS — FlociLab</PageTitle>

<h1>AWS STS</h1>

<p class="lede">
    Ask STS who is calling, create a role that trusts this account (through
    <code>AWSSDK.IdentityManagement</code> — STS refuses a role that does not exist), assume it,
    then sign a second client with the temporary credentials that came back and ask again. This is
    <code>AWSSDK.SecurityToken</code> used exactly as production would use it. The credentials
    simply expire; the role is deleted at the end, so re-running the page always starts from the
    same account. The secret access key and session token are never rendered; only their
    identifiers are.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci emulator" : "REAL AWS — this mints live credentials")
    </dd>
    <dt>Endpoint</dt>
    <dd><code>@this.Factory.ServiceUrl</code></dd>
    <dt>Package</dt>
    <dd><code>AWSSDK.SecurityToken</code> + <code>AWSSDK.IdentityManagement</code> (for the role)</dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the token exchange")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching the assumed identity
            // appear before the second GetCallerIdentity confirms it is most of the point.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally deletes the role it created.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
