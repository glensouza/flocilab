@inject IDemoCatalog Catalog
@inject ShellOptions Shell
@inject IEnumerable<NavSection> NavSections

<nav class="sidebar">
    <div class="brand">
        <a href="/">@Shell.Title</a>
        <span class="brand-sub">@Shell.Subtitle</span>
    </div>

    <ul class="nav-list">
        <li>
            <NavLink href="/" Match="NavLinkMatch.All">Overview</NavLink>
        </li>
        <li>
            <NavLink href="/coverage">Coverage matrix</NavLink>
        </li>
    </ul>

    @foreach (NavSection section in NavSections)
    {
        <DynamicComponent Type="section.Component" />
    }

    @foreach (ProviderDemos group in Catalog.ByProvider)
    {
        <div class="nav-group">
            <h2>@group.DisplayName</h2>
            <ul class="nav-list">
                @foreach (IServiceDemo demo in group.Demos)
                {
                    <li>
                        <NavLink href="@demo.Route">@demo.DisplayName</NavLink>
                    </li>
                }
            </ul>
        </div>
    }

    @if (Catalog.Demos.Count == 0)
    {
        <p class="nav-empty">
            No service demos registered yet. Each sample RCL adds itself with one
            <code>Add*Demo()</code> call in <code>Program.cs</code>.
        </p>
    }
</nav>
