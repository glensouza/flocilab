@page "/coverage"
@inject IEmulatorHealthProbe HealthProbe
@inject ICoverageMatrix Matrix
@inject IDemoCatalog Catalog
@implements IDisposable

<PageTitle>Coverage matrix</PageTitle>

<h1>Coverage matrix</h1>

<p class="lede">
    Live state, not a claim: every emulator is asked for its health, and every registered demo is
    asked for its cheapest list call. <code>NotImplemented</code> is a real answer, not a failure —
    it is how the checklists in the plan stay honest.
</p>

<div class="toolbar">
    <button class="button" @onclick="this.RefreshAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Probing…" : "Probe again")
    </button>
    @if (this.lastRun is not null)
    {
        <span class="note">Last run @this.lastRun.Value.ToLocalTime().ToString("HH:mm:ss")</span>
    }
</div>

<h2>Emulators</h2>

@if (this.health is null)
{
    <p class="note">@(this.RendererInfo.IsInteractive ? "Probing…" : "Waiting for the interactive circuit…")</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Cloud</th>
                <th>Endpoint</th>
                <th>Status</th>
                <th>Time</th>
                <th>Detail</th>
            </tr>
        </thead>
        <tbody>
            @foreach (EmulatorHealth emulator in this.health)
            {
                <tr>
                    <td>@CloudProvider.DisplayName(emulator.Provider)</td>
                    <td><code>@emulator.Endpoint</code></td>
                    <td>@StatusBadge(emulator.Result.Status)</td>
                    <td class="numeric">@Elapsed(emulator.Result)</td>
                    <td class="detail">@emulator.Result.Detail</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Service demos</h2>

@if (this.Catalog.Demos.Count == 0)
{
    <p class="empty">
        No demos registered. Each sample RCL adds itself with one <code>Add*Demo()</code> call, and
        appears here the moment it does.
    </p>
}
else if (this.coverage is null)
{
    <p class="note">Probing @this.Catalog.Demos.Count demos…</p>
}
else
{
    @foreach (IGrouping<string, DemoCoverage> group in this.coverage.GroupBy(c => c.Demo.Provider).OrderBy(g => CloudProvider.Order(g.Key)))
    {
        <h3>@CloudProvider.DisplayName(group.Key)</h3>
        <table class="grid">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Time</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DemoCoverage cell in group)
                {
                    <tr>
                        <td><a href="@cell.Demo.Route">@cell.Demo.DisplayName</a></td>
                        <td>@cell.Demo.Category</td>
                        <td>@StatusBadge(cell.Result.Status)</td>
                        <td class="numeric">@Elapsed(cell.Result)</td>
                        <td class="detail">@cell.Result.Detail</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private readonly CancellationTokenSource cts = new();

    private IReadOnlyList<EmulatorHealth>? health;
    private IReadOnlyList<DemoCoverage>? coverage;
    private DateTimeOffset? lastRun;
    private bool running;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Prerendering probes nothing: the first paint would block on every emulator and demo
        // call, and the interactive circuit would immediately repeat them.
        if (firstRender && this.RendererInfo.IsInteractive && this.lastRun is null)
        {
            await this.RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.StateHasChanged();

        try
        {
            Task<IReadOnlyList<EmulatorHealth>> healthTask = this.HealthProbe.ProbeAsync(this.Catalog.CoveredProviders, this.cts.Token);
            Task<IReadOnlyList<DemoCoverage>> coverageTask = this.Matrix.ProbeAllAsync(this.cts.Token);
            await Task.WhenAll(healthTask, coverageTask);

            this.health = await healthTask;
            this.coverage = await coverageTask;
            this.lastRun = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-probe.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    private static RenderFragment StatusBadge(ProbeStatus status) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge badge-{status.ToString().ToLowerInvariant()}");
        builder.AddContent(2, status switch
        {
            ProbeStatus.Ok => "Ok",
            ProbeStatus.NotImplemented => "501 Not implemented",
            ProbeStatus.Unreachable => "Unreachable",
            _ => "Error",
        });
        builder.CloseElement();
    };

    private static string Elapsed(ProbeResult result)
        => result.Duration is { } duration ? $"{duration.TotalMilliseconds:0} ms" : "—";

    public void Dispose()
    {
        this.disposed = true;

        // Cancel, but do not dispose: RefreshAsync may still be inside a call that registers on
        // this token — CreateLinkedTokenSource in CoverageMatrix, HttpClient.GetAsync in the health
        // probe — and disposing underneath it throws ObjectDisposedException instead of
        // cancelling, which escapes RefreshAsync and tears down the circuit.
        this.cts.Cancel();
    }
}
