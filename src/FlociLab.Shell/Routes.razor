@inject IDemoCatalog Catalog

<Router AppAssembly="typeof(App).Assembly"
        AdditionalAssemblies="@this.pageAssemblies"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // The endpoint route table is built from the same property in Program.cs; this one is what
    // routes navigations inside the interactive circuit. Both are needed, and both now read
    // IDemoCatalog.PageAssemblies, so an RCL cannot be wired into one and forgotten in the other.
    private Assembly[] pageAssemblies = [];

    protected override void OnInitialized() => this.pageAssemblies = [.. this.Catalog.PageAssemblies];
}
