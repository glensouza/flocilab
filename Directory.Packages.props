<Project>

  <!--
    Central Package Management. Non-negotiable per docs/BLAZOR-PLAN.md §5: with ~136
    sample projects each pulling a different cloud SDK, per-project pinning becomes
    unmanageable. A sample .csproj carries a bare <PackageReference Include="..." />
    with NO Version attribute; the version lives here.

    Cloud SDK versions get added to the "Cloud SDKs" group below as each sample lands.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Lets the pins below reach dependencies a cloud SDK drags in. Needed from day one:
      OCI.DotNetSDK.Common 145.0.0 and 148.1.0 asked for Newtonsoft.Json 12.0.3, which carries a known
      high-severity advisory (GHSA-5crp-9r3c-p9vr) and fails the build under warnings-as-errors.
      OCI.DotNetSDK.Common 150.0.0 asks for 13.0.4 itself (its nuspec, read 2026-11-02), and no restored
      package asks for less than 13.0.3 (read from every host's project.assets.json, 2026-11-02), so the
      Newtonsoft.Json pin is now only a floor. It stays, so a later SDK that asks for the old version
      cannot bring the advisory back.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- FlociLab.Core — contracts only, no cloud dependencies (plan §6). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
  </ItemGroup>

  <!--
    Cloud SDKs — exactly one of these per sample .csproj (plan §3, constraint 1).

    The four *.Core packages below are the exception: they belong to the per-provider endpoint
    projects (src/FlociLab.<Provider>.Endpoints), which exist so the endpoint wiring is written
    once against SDK types. Every sample already pulls them transitively through its own service
    package, so no sample gains a dependency it did not already have.
  -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.AccessAnalyzer" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.Account" Version="4.0.102.6" />
    <PackageVersion Include="AWSSDK.APIGateway" Version="4.0.101.7" />
    <PackageVersion Include="AWSSDK.ApiGatewayV2" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.ApiGatewayManagementApi" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.AppConfig" Version="4.0.101.19" />
    <PackageVersion Include="AWSSDK.AppConfigData" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.ApplicationAutoScaling" Version="4.0.100.21" />
    <PackageVersion Include="AWSSDK.AppSync" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.AutoScaling" Version="4.0.105.1" />
    <PackageVersion Include="AWSSDK.CertificateManager" Version="4.0.103" />
    <PackageVersion Include="AWSSDK.CloudControlApi" Version="4.0.100.21" />
    <PackageVersion Include="AWSSDK.CloudFormation" Version="4.0.103.5" />
    <PackageVersion Include="AWSSDK.CloudFront" Version="4.0.103.3" />
    <PackageVersion Include="AWSSDK.CloudWatch" Version="4.0.107.2" />
    <PackageVersion Include="AWSSDK.CloudWatchLogs" Version="4.0.107" />
    <PackageVersion Include="AWSSDK.CodeGuruReviewer" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.CognitoIdentityProvider" Version="4.0.106.6" />
    <PackageVersion Include="AWSSDK.Core" Version="4.0.102.16" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.109.3" />
    <PackageVersion Include="AWSSDK.ElasticBeanstalk" Version="4.0.101.7" />
    <PackageVersion Include="AWSSDK.ElasticFileSystem" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.ElasticLoadBalancing" Version="4.0.100.21" />
    <PackageVersion Include="AWSSDK.ElasticLoadBalancingV2" Version="4.0.101.18" />
    <PackageVersion Include="AWSSDK.EventBridge" Version="4.0.101.8" />
    <PackageVersion Include="AWSSDK.GlobalAccelerator" Version="4.0.101.7" />
    <PackageVersion Include="AWSSDK.IdentityManagement" Version="4.0.103.13" />
    <PackageVersion Include="AWSSDK.KeyManagementService" Version="4.0.101.1" />
    <PackageVersion Include="AWSSDK.Lightsail" Version="4.0.106" />
    <PackageVersion Include="AWSSDK.Organizations" Version="4.0.103.3" />
    <PackageVersion Include="AWSSDK.Pipes" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.RAM" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.Route53" Version="4.0.100.21" />
    <PackageVersion Include="AWSSDK.Route53Resolver" Version="4.0.100.23" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageVersion Include="AWSSDK.S3Tables" Version="4.0.100.21" />
    <PackageVersion Include="AWSSDK.S3Vectors" Version="4.0.101.6" />
    <PackageVersion Include="AWSSDK.Scheduler" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.101.7" />
    <PackageVersion Include="AWSSDK.ServiceDiscovery" Version="4.0.101.17" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.SimpleSystemsManagement" Version="4.0.104.8" />
    <PackageVersion Include="AWSSDK.SimpleWorkflow" Version="4.0.100.21" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.SSOAdmin" Version="4.0.104" />
    <PackageVersion Include="AWSSDK.StepFunctions" Version="4.0.101.1" />
    <PackageVersion Include="AWSSDK.VerifiedPermissions" Version="4.0.100.21" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageVersion Include="Google.Api.Gax.Grpc" Version="4.15.2" />
    <PackageVersion Include="Google.Cloud.Firestore" Version="4.6.0" />
    <PackageVersion Include="Google.Cloud.Kms.V1" Version="3.27.0" />
    <PackageVersion Include="Google.Cloud.PubSub.V1" Version="3.39.0" />
    <PackageVersion Include="Google.Cloud.SecretManager.V1" Version="2.8.0" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.63.3" />
    <PackageVersion Include="OCI.DotNetSDK.Common" Version="150.0.0" />
    <PackageVersion Include="OCI.DotNetSDK.Keymanagement" Version="150.0.0" />
    <PackageVersion Include="OCI.DotNetSDK.Objectstorage" Version="150.0.0" />
    <PackageVersion Include="OCI.DotNetSDK.Queue" Version="150.0.0" />
    <PackageVersion Include="OCI.DotNetSDK.Secrets" Version="150.0.0" />
    <PackageVersion Include="OCI.DotNetSDK.Vault" Version="150.0.0" />
  </ItemGroup>

  <!-- Testing (plan §10). A throwaway emulator per test class, so CI needs no running stack. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!--
      The bare Testcontainers builder, for the three emulator images the Floci module does not
      cover. FlociBuilder hardcodes port 4566 (verified by reflecting over its configuration), so
      floci-az on 4577, floci-gcp on 4588 and floci-oci on 4599 need a plain ContainerBuilder.
      Same version as the module, which is where it comes from transitively anyway.
    -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Floci" Version="4.16.0" />

    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- Transitive pins: security fixes for versions a cloud SDK asks for. -->
  <ItemGroup>
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!--
      MessagePack 2.5.302 arrives through the Aspire AppHost and carries advisory GHSA-qhrr-8q5h-9q3h
      (nested arrays blow past buffer length limits), which fails `dotnet build -warnaserror` under
      NU1902. 2.5.303 is the patched release of the 2.x line Aspire asks for; 3.x is a major version
      that Aspire has not been built against, so it is not taken. Revisit when Aspire is upgraded.
    -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

</Project>
